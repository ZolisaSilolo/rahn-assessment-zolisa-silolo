# Copy this file to .env. Never commit your .env file to version control.

# Default provider (assessment brief): Google Gemini with a free Google AI Studio key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional provider: Amazon Bedrock (uses your AWS credentials; no key in this file).
# Select it with LLM_PROVIDER=bedrock or `python -m src.main --provider bedrock`.
LLM_PROVIDER=gemini
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_REGION=us-east-1
